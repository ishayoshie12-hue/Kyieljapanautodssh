--// DRAG
local function drag(obj)
    local dragging = false
    local startPos, startInput

    obj.InputBegan:Connect(function(input)
        if locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPos = obj.Position
        end
    end)

    obj.InputEnded:Connect(function()
        dragging = false
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and not locked then
            local delta = input.Position - startInput
            obj.Position = UDim2.fromOffset(
                startPos.X.Offset + delta.X,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

drag(Main)
drag(OpenBtn)
drag(LockBtn)

--// TWEEN SYSTEM
local tweening = false
local currentTween

local function getClosestPlayer()
    local char = player.Character
    if not char then return nil end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local closest, dist = nil, math.huge

    for _,v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local mag = (v.Character.HumanoidRootPart.Position - root.Position).Magnitude
            if mag < dist then
                dist = mag
                closest = v
            end
        end
    end

    return closest
end

task.spawn(function()
    while true do
        task.wait(0.1)

        if tweening then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                local target = getClosestPlayer()

                if root and target and target.Character then
                    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")

                    if targetRoot then
                        if currentTween then
                            currentTween:Cancel()
                        end

                        local distance = (targetRoot.Position - root.Position).Magnitude
                        local speed = math.clamp(distance / 25, 0.25, 1)

                        currentTween = TweenService:Create(
                            root,
                            TweenInfo.new(speed, Enum.EasingStyle.Linear),
                            {CFrame = targetRoot.CFrame}
                        )

                        currentTween:Play()
                    end
                end
            end
        end
    end
end)

Toggle.MouseButton1Click:Connect(function()
    tweening = not tweening

    if tweening then
        Toggle.Text = "TWEEN: ON"
        Toggle.BackgroundColor3 = Color3.fromRGB(0,170,0)
    else
        Toggle.Text = "TWEEN: OFF"
        Toggle.BackgroundColor3 = Color3.fromRGB(170,0,0)

        if currentTween then
            currentTween:Cancel()
            currentTween = nil
        end
    end
end)
